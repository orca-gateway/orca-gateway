{
  "name": "@orca-gateway/engine",
  "version": "0.3.0",
  "description": "Orca Gateway SDUI Engine — server-driven UI for Flutter",
  "type": "module",
  "author": "Amr Ebada <hello@orcagateway.com>",
  "license": "BUSL-1.1",
  "homepage": "https://orcagateway.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-gateway/orca-gateway.git",
    "directory": "open-source/engine"
  },
  "bugs": {
    "url": "https://github.com/orca-gateway/orca-gateway/issues"
  },
  "keywords": [
    "sdui",
    "server-driven-ui",
    "flutter",
    "bun",
    "typescript",
    "orca-gateway",
    "orcagateway"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./middlewares": {
      "types": "./dist/middlewares/index.d.ts",
      "import": "./dist/middlewares/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "dev:examples": "bun run --watch ../examples/server/index.ts",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "bun build src/index.ts src/core/index.ts src/types/index.ts src/components/index.ts src/middlewares/index.ts --outdir dist --root src --minify --target bun --format esm --splitting",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
