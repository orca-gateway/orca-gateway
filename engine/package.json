{
  "name": "@orca-gateway/engine",
  "version": "0.1.0",
  "description": "Orca Gateway SDUI Engine — server-driven UI for Flutter",
  "type": "module",
  "author": "Amr Ebada <hello@orcagateway.com>",
  "license": "BUSL-1.1",
  "homepage": "https://orcagateway.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-gateway/orca-gateway.git",
    "directory": "open-source/engine"
  },
  "bugs": {
    "url": "https://github.com/orca-gateway/orca-gateway/issues"
  },
  "keywords": [
    "sdui",
    "server-driven-ui",
    "flutter",
    "bun",
    "typescript",
    "orca-gateway",
    "orcagateway"
  ],
  "exports": {
    "./core": "./src/core/index.ts",
    "./types": "./src/types/index.ts",
    "./components": "./src/components/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "dev:examples": "bun run --watch ../examples/server/index.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
