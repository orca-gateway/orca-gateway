<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the host app: the map shows the device's location
     (myLocationEnabled) only while the app holds one of these, granted at
     run time. The plugin never asks for them, as google_maps_flutter does
     not: the app does. The Maps API key is the app's, not this library's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Apache's HTTP client, gone from apps that target API 28+ unless their
         manifest asks for it: the Maps renderer in Google Play services can
         need it (without it the first map throws NoClassDefFoundError on
         org.apache.http.ProtocolVersion). Flutter's google_maps_flutter_android
         declares it the same way; not required, so the app still installs
         where the library is absent. -->
    <application>
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
    </application>
</manifest>
