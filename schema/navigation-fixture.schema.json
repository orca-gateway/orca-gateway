{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orcagateway.com/schemas/navigation-fixture.json",
  "title": "Navigation conformance fixture",
  "description": "Executable spec for route resolution. Every Orca SDK (Flutter, Swift, Kotlin) loads these files, builds its route table from `config`, seeds app state from `config.initialAppState` with `appState` laid over it, resolves each case's `location` as a `go` (replace) navigation and asserts `expected`. The Flutter SDK is the oracle: an expected value is what its real router shows. A file may also carry `sessions` (beside `cases` or instead of them): each session boots a fresh app at `config.initialRoute` with the seeded app state (the file-level `appState` overlay is for `cases` only), then runs its steps in order on that one app. What the SDK shows is asserted after the boot (`boot.expected`) and after every step (`expected`).",
  "type": "object",
  "required": [
    "name",
    "description",
    "config"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "config": {
      "$ref": "#/definitions/Config"
    },
    "appState": {
      "type": "object",
      "description": "Laid over `config.initialAppState` key by key, after the seed and before any case is resolved."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Case"
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Session"
      }
    }
  },
  "definitions": {
    "Config": {
      "type": "object",
      "description": "A GET /api/v1/app/:appId/config body as the engine serves it (core/app.ts getNavConfig).",
      "required": [
        "initialRoute",
        "flows"
      ],
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string"
        },
        "appName": {
          "type": "string"
        },
        "initialRoute": {
          "type": "string",
          "description": "With a leading slash, e.g. `/home`. Must resolve to a page with the seeded state."
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "navigation-config.schema.json#/definitions/TabDefinition"
          }
        },
        "drawerItems": {
          "type": "array",
          "items": {
            "$ref": "navigation-config.schema.json#/definitions/DrawerItemDefinition"
          }
        },
        "initialAppState": {
          "type": "object"
        },
        "tabBarComponents": {
          "type": "array",
          "items": {
            "$ref": "component-node.schema.json#"
          }
        },
        "drawerComponents": {
          "type": "array",
          "items": {
            "$ref": "component-node.schema.json#"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Flow"
          }
        }
      }
    },
    "Flow": {
      "type": "object",
      "required": [
        "name",
        "routes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "isStatic": {
          "type": "boolean"
        },
        "pages": {
          "type": "object",
          "description": "Pre-rendered page responses of a static flow, keyed by page path."
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Route"
          }
        }
      }
    },
    "Route": {
      "type": "object",
      "description": "One route as core/flow.ts collectRouteInfo emits it.",
      "required": [
        "path",
        "requiredAppState"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/]",
          "description": "No leading slash; `:name` is a param segment. A child carries its full path (`home/product/:id`)."
        },
        "requiredAppState": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isDynamic": {
          "type": "boolean"
        },
        "redirect": {
          "type": "object",
          "required": [
            "when",
            "equals",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "when": {
              "type": "string",
              "description": "App state key."
            },
            "equals": {
              "description": "The redirect applies while appState[when] equals this value."
            },
            "to": {
              "type": "string",
              "description": "Target location, with a leading slash."
            }
          }
        },
        "transition": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "duration": {
              "type": "integer"
            },
            "curve": {
              "type": "string"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Route"
          }
        }
      }
    },
    "Case": {
      "type": "object",
      "required": [
        "name",
        "location",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "pattern": "^/",
          "description": "The location asked for, with a leading slash and an optional query."
        },
        "expected": {
          "$ref": "#/definitions/Expected"
        }
      }
    },
    "Expected": {
      "type": "object",
      "required": [
        "kind",
        "location",
        "redirected"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "page",
            "error"
          ],
          "description": "`page`: a page is shown and requested. `error`: the router's not-found screen, no page request."
        },
        "location": {
          "type": "string",
          "description": "Final location after the redirect, query included when it survives."
        },
        "redirected": {
          "type": "boolean",
          "description": "True when the final location's path differs from the asked one's."
        },
        "pagePath": {
          "type": "string",
          "description": "Page request path of the top page: the final location without its leading slash and query."
        },
        "routePath": {
          "type": "string",
          "description": "Full matched pattern with a leading slash, e.g. `/home/product/:id`."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Path params of every matched level."
        },
        "stack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Page request paths bottom to top after a `go`: the parent chain of a nested route, then the page itself."
        },
        "tabIndex": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Index into config.tabs of the tab that shows the page; null without tabs and for a route outside every tab."
        },
        "scaffoldTitle": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fallback title of the title bar a non-tab route is wrapped in (the page's own title wins once loaded); null when the page is not wrapped."
        },
        "appState": {
          "type": "object",
          "description": "Optional: the whole app state at resolve time."
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "required": [
          "pagePath",
          "routePath",
          "params",
          "stack",
          "tabIndex",
          "scaffoldTitle"
        ]
      },
      "else": {
        "propertyNames": {
          "enum": [
            "kind",
            "location",
            "redirected"
          ]
        }
      }
    },
    "Session": {
      "type": "object",
      "description": "One run of a booted app. The boot is not a step: the app starts at `config.initialRoute` and `boot.expected` pins what is shown then, so the boot's page requests (the initial route's page) and the first `_tabIndex` write are accounted for there and never in the first step.",
      "required": [
        "name",
        "boot",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "boot": {
          "type": "object",
          "required": [
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      }
    },
    "Step": {
      "description": "One operation and what is shown once it has settled.",
      "oneOf": [
        {
          "type": "object",
          "description": "Replace navigation to a location (GoRouter.go).",
          "required": [
            "op",
            "location",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "go"
            },
            "location": {
              "type": "string",
              "pattern": "^/",
              "description": "A location with a leading slash."
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        {
          "type": "object",
          "description": "Push a location over what is shown (GoRouter.push).",
          "required": [
            "op",
            "location",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "push"
            },
            "location": {
              "type": "string",
              "pattern": "^/",
              "description": "A location with a leading slash."
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        {
          "type": "object",
          "description": "Pop the top page (GoRouter.pop). Never written where there is nothing to pop: at a tab root Flutter's router throws and the platform's back leaves the app.",
          "required": [
            "op",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "back"
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        {
          "type": "object",
          "description": "A tap on the item at `index` of the default tab bar. Only written while the bar is on screen.",
          "required": [
            "op",
            "index",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "tapTab"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        {
          "type": "object",
          "description": "The `switchTab` action run by the action executor from the page on screen.",
          "required": [
            "op",
            "tabId",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "switchTab"
            },
            "tabId": {
              "type": "string"
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        },
        {
          "type": "object",
          "description": "One key written into app state through the state manager.",
          "required": [
            "op",
            "key",
            "value",
            "expected"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "setAppState"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "description": "Any JSON value, null included."
            },
            "expected": {
              "$ref": "#/definitions/Observed"
            }
          }
        }
      ]
    },
    "Observed": {
      "type": "object",
      "description": "What the SDK shows after the boot or after a step. All four keys are always present.",
      "required": [
        "location",
        "tabIndex",
        "appState",
        "pageRequests"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "description": "The visible location: the one of the page on top, also when it was pushed."
        },
        "tabIndex": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The tab shell's current index while a shell exists, also under a route pushed over it; null when there is no shell (after a `go` to a route outside the tabs)."
        },
        "appState": {
          "type": "object",
          "description": "A subset of app state: every key listed is compared, other keys are not looked at. Carries `_tabIndex`."
        },
        "pageRequests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Page request paths (no leading slash) made during the boot or during this step, in order; empty when nothing is fetched."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "cases"
      ]
    },
    {
      "required": [
        "sessions"
      ]
    }
  ]
}
