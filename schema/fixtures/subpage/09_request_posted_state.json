{
  "name": "request-posted-state",
  "description": "S6. A serverAction fired from a node inside a sub-page posts, as `pageState`, only the keys under that sub-page's prefix, with the prefix removed. The sub-page is the mounted prefix the source node id starts with; the longest one wins, so a node of a nested sub-page belongs to the nested one. A source in the host page, or no source at all, matches nothing: the prefix is null and the whole page state is posted. A page sees the keys of the sub-pages nested in it under their own prefix, as a host does.",
  "kind": "request",
  "cases": [
    {
      "name": "a node of page 0",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail:3",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail:",
        "pageState": {
          "count": 3,
          "user": {
            "name": "Ann"
          },
          "inner:tab": "posts",
          "inner#1:tab": "likes"
        }
      }
    },
    {
      "name": "a node of a joined page",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail#1:0",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail#1:",
        "pageState": {
          "count": 9
        }
      }
    },
    {
      "name": "the prefix is matched whole",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail#10:0",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail#10:",
        "pageState": {
          "count": 10
        }
      }
    },
    {
      "name": "a node of a nested sub-page: the longest prefix wins",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail:inner:2",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail:inner:",
        "pageState": {
          "tab": "posts"
        }
      }
    },
    {
      "name": "a node of a page joined to the nested sub-page",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail:inner#1:0",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail:inner#1:",
        "pageState": {
          "tab": "likes"
        }
      }
    },
    {
      "name": "the nested SubPage node itself belongs to the outer page",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail:inner",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": "detail:",
        "pageState": {
          "count": 3,
          "user": {
            "name": "Ann"
          },
          "inner:tab": "posts",
          "inner#1:tab": "likes"
        }
      }
    },
    {
      "name": "a host node",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "save-button",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      }
    },
    {
      "name": "the SubPage node itself is a host node",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detail",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      }
    },
    {
      "name": "a host node whose id only starts like the key",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": "detailed:0",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      }
    },
    {
      "name": "no source",
      "action": {
        "prefixes": [
          "detail:",
          "detail#1:",
          "detail#10:",
          "detail:inner:",
          "detail:inner#1:"
        ],
        "sourceId": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      }
    },
    {
      "name": "no sub-page mounted",
      "action": {
        "prefixes": [],
        "sourceId": "detail:3",
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
        }
      },
      "expected": {
        "prefix": null,
        "pageState": {
          "hostCount": 1,
          "detail": "a host key named like the sub-page",
          "detail:count": 3,
          "detail:user": {
            "name": "Ann"
          },
          "detail#1:count": 9,
          "detail#10:count": 10,
          "detail:inner:tab": "posts",
          "detail:inner#1:tab": "likes",
          "detailed:count": 5
