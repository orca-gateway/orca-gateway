        },
        {
          "type": "custom:group",
          "actions": [
            {
              "type": "setState",
              "scope": "page",
              "key": "done",
              "value": {
                "type": "static",
                "value": true
              }
            },
            {
              "type": "openDialog",
              "dialogId": "thanks"
            }
          ]
        }
      ],
      "expected": [
        {
          "type": "custom:cache",
          "key": "draft",
          "scope": "page",
          "stateKey": "draft",
          "id": "row-1",
          "value": {
            "type": "state",
            "key": "detail:draft",
            "scope": "page"
          }
        },
        {
          "type": "custom:group",
          "actions": [
            {
              "type": "setState",
              "scope": "page",
              "key": "detail:done",
              "value": {
                "type": "static",
                "value": true
              }
            },
            {
              "type": "openDialog",
              "dialogId": "detail:thanks"
            }
          ]
        }
      ]
    },
