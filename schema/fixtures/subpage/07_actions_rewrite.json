          "pageId": "feed",
          "mode": "replace"
        },
        {
          "type": "updateSubPage",
          "subPageId": {
            "type": "state",
            "key": "target",
            "scope": "app"
          },
          "pageId": "feed",
          "mode": "replace"
        },
        {
          "type": "setState",
          "scope": "page",
          "key": "detail:copy",
          "value": {
            "type": "static",
            "value": {
              "type": "state",
              "key": "count",
              "scope": "page"
            }
          }
