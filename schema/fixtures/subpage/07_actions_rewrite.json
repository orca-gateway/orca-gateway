    {
      "name": "nested actions",
      "prefix": "detail#2:",
      "actions": [
        {
          "type": "actionGroup",
          "mode": "sequential",
          "actions": [
            {
              "type": "conditionalAction",
              "branches": [
                {
                  "when": {
                    "op": "isNull",
                    "value": {
                      "type": "state",
                      "key": "user",
                      "scope": "page"
                    }
                  },
                  "then": {
                    "type": "openDialog",
                    "dialogId": "login"
                  }
                }
              ],
              "else": {
                "type": "actionGroup",
                "mode": "parallel",
                "actions": [
                  {
                    "type": "animateForward",
                    "animationId": "pulse"
                  },
                  {
                    "type": "setState",
                    "scope": "page",
                    "key": "seen",
                    "value": {
                      "type": "static",
                      "value": true
                    }
                  }
                ]
              }
            },
            {
              "type": "lifecycle",
              "action": {
                "type": "serverAction",
                "id": "load",
                "params": {
                  "page": {
                    "type": "state",
                    "key": "page",
                    "scope": "page"
                  },
                  "token": {
                    "type": "state",
                    "key": "token",
                    "scope": "app"
                  }
                }
              },
              "onSuccess": {
                "type": "updateSubPage",
                "subPageId": "feed",
                "pageId": "feed/more",
                "mode": "join"
              },
              "onError": [
                {
                  "type": "setState",
                  "scope": "page",
                  "key": "error",
                  "value": {
                    "type": "event",
                    "key": "message"
                  }
                },
                {
                  "type": "animateReverse",
                  "animationId": "pulse"
                }
              ]
            },
            {
              "type": "once",
              "action": {
                "type": "clearState",
                "scope": "page",
                "key": "draft"
              }
            },
            {
              "type": "custom:track",
              "name": "opened",
              "value": {
                "type": "state",
                "key": "count",
                "scope": "page"
              }
            }
          ]
        }
      ],
      "expected": [
        {
          "type": "actionGroup",
          "mode": "sequential",
          "actions": [
            {
              "type": "conditionalAction",
              "branches": [
                {
                  "when": {
                    "op": "isNull",
                    "value": {
                      "type": "state",
                      "key": "detail#2:user",
                      "scope": "page"
                    }
                  },
                  "then": {
                    "type": "openDialog",
                    "dialogId": "detail#2:login"
                  }
                }
              ],
              "else": {
                "type": "actionGroup",
                "mode": "parallel",
                "actions": [
                  {
                    "type": "animateForward",
                    "animationId": "detail#2:pulse"
                  },
                  {
                    "type": "setState",
                    "scope": "page",
                    "key": "detail#2:seen",
                    "value": {
                      "type": "static",
                      "value": true
                    }
                  }
                ]
              }
            },
            {
              "type": "lifecycle",
              "action": {
                "type": "serverAction",
                "id": "load",
                "params": {
                  "page": {
                    "type": "state",
                    "key": "detail#2:page",
                    "scope": "page"
                  },
                  "token": {
                    "type": "state",
                    "key": "token",
                    "scope": "app"
                  }
                }
              },
              "onSuccess": {
                "type": "updateSubPage",
                "subPageId": "detail#2:feed",
                "pageId": "feed/more",
                "mode": "join"
              },
              "onError": [
                {
                  "type": "setState",
                  "scope": "page",
                  "key": "detail#2:error",
                  "value": {
                    "type": "event",
                    "key": "message"
                  }
                },
                {
                  "type": "animateReverse",
                  "animationId": "detail#2:pulse"
                }
              ]
            },
            {
              "type": "once",
              "action": {
                "type": "clearState",
                "scope": "page",
                "key": "detail#2:draft"
              }
            },
            {
              "type": "custom:track",
              "name": "opened",
              "value": {
                "type": "state",
                "key": "detail#2:count",
                "scope": "page"
              }
            }
          ]
        }
      ]
    },
