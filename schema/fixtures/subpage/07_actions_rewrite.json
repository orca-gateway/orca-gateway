          "value": {
            "type": "state",
            "key": "count"
          }
        },
        {
          "type": "showSnackbar",
          "message": {
            "type": "state",
            "key": "message"
          }
        }
      ],
      "expected": [
        {
          "type": "setState",
          "scope": "page",
          "key": "detail:copy",
          "value": {
            "type": "state",
            "key": "detail:legacy"
          }
        },
        {
          "type": "setState",
          "scope": "page",
          "key": "detail:copy",
          "value": {
            "type": "state",
            "scope": "page",
            "key": "detail:count"
          }
        },
        {
          "type": "setState",
          "scope": "app",
          "key": "copy",
          "value": {
            "type": "state",
            "key": "detail:count"
          }
        },
        {
          "type": "showSnackbar",
          "message": {
            "type": "state",
            "key": "detail:message"
          }
        }
      ]
    },
    {
      "name": "a plugin action: its references are rewritten, its literal key fields are not",
      "prefix": "detail:",
      "actions": [
        {
          "type": "custom:cache",
          "key": "draft",
          "scope": "page",
          "stateKey": "draft",
          "id": "row-1",
          "value": {
            "type": "state",
            "key": "draft",
            "scope": "page"
