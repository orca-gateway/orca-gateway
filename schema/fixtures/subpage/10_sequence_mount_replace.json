            "roots": [
              "detail:0"
            ],
            "nodeIds": [
              "detail:0",
              "detail:1",
              "detail:2"
            ],
            "removedNodeIds": [
              "detail:0",
              "detail:1"
            ],
            "state": {
              "hostCount": 1,
              "detail:name": "Bea"
            }
          }
        }
      ]
    },
    {
