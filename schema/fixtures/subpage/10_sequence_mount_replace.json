          }
        },
        {
          "op": "update",
          "mode": "replace",
          "response": {
            "pageId": "profile",
            "title": "",
            "state": [
              {
                "key": "name",
                "scope": "page",
                "initial": "Bea"
              }
            ],
            "components": [
              {
                "id": "0",
                "type": "Column",
                "kind": "layout",
                "childMode": "multi",
                "props": {},
                "children": [
                  "1",
                  "2"
                ],
                "watches": []
              },
              {
                "id": "2",
                "type": "Text",
