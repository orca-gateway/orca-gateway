{
  "name": "tween-transform",
  "description": "Count-up: a transform over a tweenSequence (the enclosing AnimatedBuilder's progress) with an info scalar in a step param. Tweens are client-only, so the tree MUST survive server resolution (it used to be evaluated on the server and arrive as null); only the info leaf collapses to a static wrapper. Tweens carry no watches.",
  "input": {
    "type": "Text",
    "key": "t",
    "props": {
      "data": {
        "type": "transform",
        "input": {
          "type": "tweenSequence",
          "items": [
            {
              "value": 0,
              "duration": 0
            },
            {
              "value": 1,
              "duration": 600
            }
          ]
        },
        "by": [
          {
            "type": "multiply",
            "by": {
              "type": "info",
              "key": "target"
            }
          },
          {
            "type": "round"
          }
        ]
      }
    }
  },
  "context": {
    "pageState": {},
    "appState": {},
    "infoData": {
      "target": 42
    },
    "requestInfo": {},
    "config": {}
  },
  "expected": [
    {
      "id": "t",
      "type": "Text",
      "kind": "primitive",
      "childMode": "none",
      "props": {
        "data": {
          "type": "transform",
          "input": {
            "type": "tweenSequence",
            "items": [
              {
                "value": 0,
                "duration": 0
              },
              {
                "value": 1,
                "duration": 600
              }
            ]
          },
          "by": [
            {
              "type": "multiply",
              "by": {
                "type": "static",
                "value": 42
              }
            },
            {
              "type": "round"
            }
          ]
        }
      },
      "children": [],
      "watches": []
    }
  ]
