    "type": "RichText",
    "key": "t",
    "props": {
      "text": {
        "text": "Hello ",
        "style": {
          "fontWeight": "bold",
          "color": "#1E88E5"
        },
        "children": [
          {
            "text": "world",
            "style": {
              "fontStyle": "italic",
              "color": "#43A047"
            },
            "children": [
              {
                "text": {
                  "type": "state",
                  "key": "name",
                  "scope": "page"
                },
                "style": {
                  "color": "#E53935",
                  "decoration": "underline"
                }
              }
            ]
          },
          {
            "text": {
              "type": "static",
              "value": "!"
            }
          }
        ]
      },
      "textAlign": "center",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  },
  "context": {
    "pageState": {
      "name": "Ada"
    },
    "appState": {},
    "infoData": null,
    "requestInfo": {},
    "config": {}
  },
  "expected": [
    {
      "id": "t",
      "type": "RichText",
      "kind": "primitive",
      "childMode": "none",
      "props": {
        "text": {
          "text": "Hello ",
