                  },
                  "style": {
                    "color": "#E53935",
                    "decoration": "underline"
                  }
                }
              ]
            },
            {
              "text": "!"
            }
          ]
        },
        "textAlign": "center",
        "maxLines": 1,
        "overflow": "ellipsis"
      },
      "children": [],
