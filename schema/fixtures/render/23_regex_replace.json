{
  "name": "regex-replace",
  "description": "RegexTransform in replace-mode with `$1` capture-group backreferences + a `{{value}}` placeholder (= the full match). The `g` flag makes it replace all matches. No state refs → collapses to a plain string. Covers the replacement feature that didn't exist before.",
  "input": {
    "type": "Text",
    "key": "t",
    "props": {
      "data": {
        "type": "transform",
        "input": { "type": "info", "key": "csv" },
        "by": [
          {
            "type": "regex",
            "pattern": "(\\w+)=(\\d+)",
            "flags": "g",
            "replacement": "[$1:$2]"
          }
        ]
      }
    }
  },
  "context": {
    "pageState": {},
    "appState": {},
    "infoData": { "csv": "a=1, b=22, c=333" },
    "requestInfo": {},
    "config": {}
  },
  "expected": [
    {
      "id": "t",
      "type": "Text",
      "kind": "primitive",
      "childMode": "none",
      "props": { "data": "[a:1], [b:22], [c:333]" },
      "children": [],
      "watches": []
    }
  ]
}
