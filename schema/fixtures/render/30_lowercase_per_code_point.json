{
  "name": "lowercase-per-code-point",
  "description": "`toLowerCase` maps each code point on its own, as Dart's VM does: \"\u039f\u0394\u039f\u03a3\" gives \"\u03bf\u03b4\u03bf\u03c3\", ending in U+03C3, not the final sigma U+03C2 that context-sensitive lowercasing would pick. The input reads page state, so the engine keeps the transform unresolved with `watches`.",
  "input": {
    "type": "Text",
    "key": "t",
    "props": {
      "data": {
        "type": "transform",
        "input": {
          "type": "state",
          "scope": "page",
          "key": "word"
        },
        "by": [
          {
            "type": "toLowerCase"
          }
        ]
      }
    }
  },
  "context": {
    "pageState": {
      "word": "\u039f\u0394\u039f\u03a3"
    },
    "appState": {},
    "infoData": null,
    "requestInfo": {},
    "config": {}
  },
  "expected": [
    {
      "id": "t",
      "type": "Text",
      "kind": "primitive",
      "childMode": "none",
      "props": {
        "data": {
          "type": "transform",
          "input": {
            "type": "state",
            "scope": "page",
            "key": "word"
          },
          "by": [
            {
              "type": "toLowerCase"
            }
          ]
        }
      },
      "children": [],
      "watches": [
        "word"
      ]
    }
  ],
  "resolved": {
    "t": {
      "data": "\u03bf\u03b4\u03bf\u03c3"
    }
  }
}
